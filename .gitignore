# 1) игнорируем ВСЁ в корне репозитория
/*

# 2) сам .gitignore тоже должен быть в git
!/.gitignore

# кэш Python (включая /core/__pycache__/) не должен попадать в репозиторий
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class

# 3) разрешаем папки проекта, но их содержимое снова игнорируем
#    (без строки /папка/* внутрь попадёт вообще всё)
!/console/
/console/*
!/core/
/core/*
!/gui/
/gui/*
!/mobile/
/mobile/*
!/tests/
/tests/*

# 4) точечно разрешаем файлы из списка
!/build_x86.bat
!/getfiles.py
!/main.py
!/mergefiles.py
!/sfx.bat
!/wlsGUI.bat
!/wlsconsol.bat
!/icon.png

!/console/__init__.py
!/console/terminal.py

!/core/__init__.py
!/core/backup.py
!/core/cloud.py
!/core/config.py
!/core/engine.py
!/core/files.py
!/core/gfs.py
!/core/i18n.py
!/core/network.py
!/core/scheduler.py

!/gui/__init__.py
!/gui/dialogs.py
!/gui/styles.py
!/gui/tray.py
!/gui/widgets.py
!/gui/window.py

!/mobile/__init__.py
!/mobile/android_app.py

!/tests/test_linux_tray.py
!/tests/test_app_icon.py
