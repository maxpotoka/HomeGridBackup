cat > .gitignore << 'EOF'
# Игнорировать всё по умолчанию
*

# Разрешённые файлы и папки проекта
!.gitignore
!main.py
!icon.ico
!buildozer.spec
!.github/
!.github/**
!core/
!core/**
!gui/
!gui/**
!console/
!console/**
!mobile/
!mobile/**

# Внутри разрешённых папок всё равно исключаем мусор
__pycache__/
*.pyc
*.py[cod]
*.log
*.zip
*.sha256
*.tmp
*.bak
.env
config.json
EOF
git add .gitignore
git status --short
