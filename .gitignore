# 1) игнорируем ВСЁ в корне репозитория
/*

# 2) сам .gitignore тоже должен быть в git
!/.gitignore

# кэш Python (включая /core/__pycache__/) не должен попадать в репозиторий
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.py[cod]
*$py.class

# 3) разрешаем папки проекта, но их содержимое снова игнорируем
#    (без строки /папка/* внутрь попадёт вообще всё)
!/console/
/console/*
!/core/
/core/*
!/core/build_variant.py
!/gui/
/gui/*
!/mobile/
/mobile/*
!/tests/
/tests/*
!/packaging/
/packaging/*

# 4) точечно разрешаем файлы из списка
!/build_x86.bat
!/getfiles.py
!/main.py
!/mergefiles.py
!/sfx.bat
!/wlsGUI.bat
!/packaging/install_hints_before.txt
!/packaging/install_hints_after.txt
!/wlsconsol.bat
!/icon.png


!/console/__init__.py
!/console/terminal.py

!/gui/stats_view.py
!/core/speed_bench.py
!/core/__init__.py
!/core/backup.py
!/core/cloud.py
!/core/config.py
!/core/engine.py
!/core/files.py
!/core/gfs.py
!/core/i18n.py
!/core/network.py
!/core/scheduler.py

!/gui/__init__.py
!/gui/dialogs.py
!/gui/styles.py
!/gui/tray.py
!/gui/widgets.py
!/gui/window.py

!/mobile/__init__.py
!/mobile/android_app.py

!/tests/test_linux_tray.py
!/tests/test_app_icon.py
!/tests/test_cloud.py
!/tests/test_last_backup_info.py
!/tests/test_tray_platforms.py

!/packaging/windows_user_setup.iss
.patch_bak/
.version_bak/

# 5) автоматически добавленные файлы проекта
!/AI_CONTEXT.md
!/MODULES.md
!/PATCH_RULES.md
!/anchor_dump.txt
!/bump_version.py
!/clean_temp.py
