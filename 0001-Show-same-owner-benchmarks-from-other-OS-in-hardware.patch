From c07e504403147995850af4db4cf039a58b170718 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 26 Nov 2026 16:59:36 +0200
Subject: [PATCH] Show same-owner benchmarks from other OS in hardware
 comparison

Benchmarks recorded on another OS of the same machine were hidden as
'mine' and never shown. Now they appear in the D1 column of the hardware
section, while the 'mine' column keeps only local OS results.

Co-Authored-By: Claude Haiku 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013N4KvwJD8dwgFsTcvgvxAh
---
 core/cloud.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/cloud.py b/core/cloud.py
index 155b844..43dca78 100644
--- a/core/cloud.py
+++ b/core/cloud.py
@@ -525,7 +525,10 @@ def build_three_section_stats(engine, refresh=True):
     from core.speed_bench import load_local_benchmarks, _hw_tag
     def_pc = f"{_pl.node()} ({_hw_tag()})"[:48]
     d1_b = [r for r in d1 if r.get('kind') == 'bench' or str(r.get('adapter') or '').lower() == 'bench' or float(r.get('cpu_mbs') or r.get('avg_cpu') or 0) > 0]
-    my_b = load_local_benchmarks() + [r for r in all_d1 if _is_mine(r) and (r.get('kind') == 'bench' or float(r.get('cpu_mbs') or 0) > 0)]
+    _loc_os = _os_base_norm(_os_arch_lbl(''))
+    _mine_b = [r for r in all_d1 if _is_mine(r) and (r.get('kind') == 'bench' or float(r.get('cpu_mbs') or 0) > 0)]
+    d1_b = d1_b + [r for r in _mine_b if _os_base_norm(r.get('os_label')) != _loc_os]
+    my_b = load_local_benchmarks() + [r for r in _mine_b if _os_base_norm(r.get('os_label')) == _loc_os]
     by_pc = {}
     for x in my_b:
         pc_n = str(x.get('pc') or def_pc).strip() or def_pc
